# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
ANALYSIS_REASONING_EFFORT=none
GENERATION_REASONING_EFFORT=low
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
CORPUS_DIR=./corpus
STATIC_DIR=./frontend/dist

# Retrieval
VECTOR_SEARCH_TOP_K=20
BM25_SEARCH_TOP_K=20
FUSION_TOP_K=20
FINAL_EVIDENCE_TOP_K=5
MIN_VECTOR_RELEVANCE=0.30
VECTOR_RRF_WEIGHT=1.0
BM25_RRF_WEIGHT=1.0
ARTICLE_REFERENCE_RRF_WEIGHT=1.5
RETRIEVAL_PROFILE=balanced_article
RERANKER_ENABLED=true
RERANKER_MODEL=gpt-4o-mini
RERANKER_CANDIDATE_TOP_K=10
OUTPUT_VALIDATION_ENABLED=true
OUTPUT_VALIDATION_MODEL=gpt-4o-mini

# Sessions
REDIS_URL=
SESSION_TTL_SECONDS=86400
SESSION_MAX_MESSAGES=40
MAX_CONTEXT_MESSAGES=10

# HTTP
CHAT_RATE_LIMIT=10/minute
HISTORY_RATE_LIMIT=60/minute
DELETE_RATE_LIMIT=20/minute
CORS_ORIGINS=

# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tanya-lalin
